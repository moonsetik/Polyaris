<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_card" android:orientation="vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp"
    android:paddingTop="6dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Дела на сегодня" android:textSize="17sp"
            android:textColor="#202037" android:fontFamily="sans-serif-medium"/>
        <ImageView android:id="@+id/widget_add" android:layout_width="48dp" android:layout_height="48dp"
            android:scaleType="center" android:src="@drawable/widget_plus"
            android:contentDescription="Добавить дело на сегодня"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/widget_tasks" android:layout_width="match_parent"
            android:layout_height="match_parent" android:divider="#EBE7F4"
            android:dividerHeight="1dp" android:scrollbars="vertical"/>
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center"
            android:padding="4dp" android:text="Дел на сегодня пока нет"
            android:textSize="14sp" android:textColor="#626479"/>
    </FrameLayout>
</LinearLayout>
